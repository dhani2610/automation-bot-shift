# Salin ke .env dan sesuaikan dengan konfigurasi MySQL / phpMyAdmin Anda
# Default XAMPP MariaDB: port 3306, user root, password kosong
# Jika memakai MySQL 8.0 Standalone: port 3307 dan isi password root Anda
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=locum_booking

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

